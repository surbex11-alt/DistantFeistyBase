<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="#030604">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="◈ WIFI SENTINEL // V1.2" android:textColor="#00FF66" android:textSize="21sp" android:textStyle="bold"/>
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="READY • RADAR OFFLINE" android:textColor="#66FFAA" android:textSize="11sp" android:paddingTop="3dp"/>
 <Button android:id="@+id/scanButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="◉ SCAN ACCESS POINTS" android:textColor="#001a08" android:backgroundTint="#00FF66" android:layout_marginTop="8dp"/>
 <com.wifisentinel.MainActivity$RadarView android:id="@+id/radar" android:layout_width="match_parent" android:layout_height="190dp" android:layout_marginTop="7dp"/>
 <TextView android:id="@+id/count" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 APs detected" android:textColor="#00FFFF" android:textSize="14sp" android:paddingTop="5dp"/>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#07100D" android:padding="7dp">
    <TextView android:id="@+id/selectedInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SELECT AN AP" android:textColor="#66FFAA" android:textSize="13sp"/>
    <TextView android:id="@+id/analysis" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SIGNAL ANALYSIS" android:textColor="#00FFFF" android:textSize="12sp" android:paddingTop="5dp"/>
    <com.wifisentinel.MainActivity$SignalGraph android:id="@+id/graph" android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginTop="5dp"/>
    <Button android:id="@+id/calibrateButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CALIBRATE SELECTED AP @ 1M" android:textSize="11sp" android:backgroundTint="#123C2A" android:textColor="#66FFAA"/>
   </LinearLayout>
   <TextView android:id="@+id/channels" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CHANNEL ANALYZER" android:textColor="#00FFFF" android:textSize="12sp" android:padding="7dp"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VISIBLE ACCESS POINTS" android:textColor="#00FF66" android:textSize="13sp" android:padding="5dp"/>
   <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
  </LinearLayout>
 </ScrollView>
</LinearLayout>
